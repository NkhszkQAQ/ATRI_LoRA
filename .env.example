# === ATRI LoRA runtime ===
COMPOSE_PROJECT_NAME=atri-companion
ATRI_NETWORK_NAME=atri-companion-net

# Public ports (host)
WEB_PORT=3080
API_PORT=3081
OLLAMA_HOST_PORT=11435
POSTGRES_HOST_PORT=5433

# Postgres
POSTGRES_DB=atri
POSTGRES_USER=atri
POSTGRES_PASSWORD=change-me-atri-db

# API
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3080

# Ollama (reuse image; project-local model store)
OLLAMA_IMAGE=ollama/ollama:0.17.7
# Inference: host LoRA server (recommended after SFT) or in-compose Ollama
OLLAMA_BASE_URL=http://host.docker.internal:8008
ATRI_MODEL=atri-qwen3-4b-lora
# OLLAMA_BASE_URL=http://ollama:11434
# ATRI_MODEL=qwen3:4b
# Auto-select: wait seconds for manual override (0 = skip wait in non-interactive)
MODEL_CONFIRM_SECONDS=10
# Force model (skip detect): qwen3:4b | qwen3:8b | none
MODEL_FORCE=

# SMTP (optional; can also be set via CLI init / admin settings)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# First admin bootstrap (used by `docker compose run --rm api python -m app.cli init`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Admin
